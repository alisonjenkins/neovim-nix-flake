 /// Functions calculating horizontal size of text, when displayed in a window.
 
+/// True when any byte of "w" is not printable ASCII (0x20 to 0x7e).
+static inline bool word_has_nonprintable(uint64_t w)
+  FUNC_ATTR_CONST
+{
+  const uint64_t ones = 0x0101010101010101ULL;
+  const uint64_t highs = 0x8080808080808080ULL;
+  const uint64_t not7f = w ^ (ones * 0x7f);
+  // Bit hacks from "Bit Twiddling Hacks": a high bit is set when a byte is >= 0x80,
+  // < 0x20 or == 0x7f.  The result is only exact as a yes/no answer.
+  return ((w & highs)
+          | ((w - ones * 0x20) & ~w & highs)
+          | ((not7f - ones) & ~not7f & highs)) != 0;
+}
+
+/// Count the bytes at the start of "s" that are printable ASCII (0x20 to 0x7e),
+/// reading at most "maxlen" bytes and never past the terminating NUL.
+///
+/// Each of those bytes takes exactly one cell, does not expand like a TAB and does
+/// not combine with the byte before it.  Walking a very long line character by
+/// character to find a column is O(line length) with a big constant; this does it
+/// eight bytes at a time.  A caller must leave the last byte of a run to its general
+/// code, because it may be followed by a combining character.
+size_t ascii_print_run(const char *s, size_t maxlen)
+{
+  size_t total = 0;
+  while (total < maxlen) {
+    // strnlen() stops at the NUL, so the word loads below stay inside the string.
+    const size_t want = MIN(maxlen - total, 4096);
+    const size_t chunk = strnlen(s + total, want);
+    size_t i = 0;
+    for (; i + sizeof(uint64_t) <= chunk; i += sizeof(uint64_t)) {
+      uint64_t w;
+      memcpy(&w, s + total + i, sizeof(w));
+      if (word_has_nonprintable(w)) {
+        break;
+      }
+    }
+    for (; i < chunk; i++) {
+      const uint8_t c = (uint8_t)s[total + i];
+      if (c < 0x20 || c >= 0x7f) {
+        return total + i;
+      }
+    }
+    total += chunk;
+    if (chunk < want) {
+      break;  // reached the NUL
+    }
+  }
+  return total;
+}
