+/// Width of the cursor line, for Ins.start_textlen.
+///
+/// Ins.start_textlen is only read by internal formatting with 'textwidth' and
+/// the "l" flag of 'formatoptions'.  Measuring the line costs O(line length)
+/// and happens every time Insert mode is entered, which is about 150 ms on a
+/// 100 MB line, so skip it when nothing can read the value.  Return -1 then;
+/// internal_format() measures the line the first time it needs the value, in
+/// case 'textwidth' or 'formatoptions' were set after Insert mode started.
+static colnr_T insert_line_width(void)
+{
+  if ((curbuf->b_p_tw <= 0 && curbuf->b_p_wm == 0) || !has_format_option(kFoInsLong)) {
+    return -1;
+  }
+  return linetabsize_str(get_cursor_line_ptr());
+}
