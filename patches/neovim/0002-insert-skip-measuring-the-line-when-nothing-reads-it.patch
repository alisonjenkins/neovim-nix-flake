-  Ins.start_textlen = linetabsize_str(get_cursor_line_ptr());
+  Ins.start_textlen = insert_line_width();
   Ins.start_blank_vcol = MAXCOL;
 
   if (!Ins.did_ai) {
@@ -2229,7 +2243,7 @@
       // right, except when nothing was inserted yet.
